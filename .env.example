# PostgreSQL. Example only; replace with your own local credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apsis_pro?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Gemini API key is used ONLY on the server.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
